rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow users to read and write their own profile
    match /users/{userId} {
      allow read, write: if true;
    }

    // Community aid requests: public read, authenticated create/update
    match /aidRequests/{requestId} {
      allow read: if true;
      allow create, update: if true;
    }

    // Supply batches: public read, authenticated create/update
    match /supplyBatches/{batchId} {
      allow read: if true;
      allow create, update: if true;
    }

    // Default test connection document
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
